{
  "tests": [
    {
      "name": "transcribe_full_model",
      "input": {
        "engine": "stable-whisper",
        "model": "ivrit-ai/whisper-large-v3-ct2",
        "streaming": false,
        "transcribe_args": {
          "url": "https://github.com/metaldaniel/HebrewASR-Comparison/raw/main/HaTankistiot_n12-mp3.mp3",
          "language": "he",
          "diarize": false
        }
      },
      "timeout": 600000
    }
  ],
  "config": {
    "gpuId": "AMPERE_16",
    "gpuCount": 1,
    "env": [
      {
        "key": "UNUSED_ENV_KEY_HERE",
        "value": "UNUSED_ENV_VALUE_HERE"
      }
    ],
    "allowedCudaVersions": [
      "12.8",
      "12.9",
      "13.0",
      "13.1",
      "13.2"
    ]
  }
}
